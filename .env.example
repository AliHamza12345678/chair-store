# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Neon Database Connection String
DATABASE_URL="postgresql://user:password@neon.tech.host/dbname?sslmode=require"

# Next Auth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-strong-secret-and-put-it-here"

# Base URL of the deployed app — used in email links (password reset,
# order confirmation) and JazzCash return URLs. Same value as NEXTAUTH_URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudinary Setup for Image Uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-upload-preset"

# Resend for Email Notifications
RESEND_API_KEY="re_123456789"
NEXT_PUBLIC_STORE_EMAIL="hello@yourstore.com"

# Upstash Redis for Rate Limiting (Optional, falls back gracefully)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Stripe Payment Gateway
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# JazzCash (installment payments) — from your JazzCash Merchant Dashboard
# Integration Guide / Postman collection. Required for the /api/webhooks/jazzcash
# route to verify incoming callbacks; without these the webhook rejects everything.
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""

# Protects app/api/cron/installment-reminders from being called by randoms.
# Generate with: openssl rand -base64 32
# Vercel Cron sends its own Authorization header automatically; any other
# scheduler must send "Authorization: Bearer <this value>".
CRON_SECRET=""

# Sentry Observability
NEXT_PUBLIC_SENTRY_DSN=""
